generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Live config — never FK-linked to Estimate.
// At estimate creation time, values are COPIED (snapshotted) into EstimateLineItem.
//
// Multi-tenant: each Supabase auth user owns exactly one PricingSettings row.
// userId stores the Supabase auth.users.id (UUID as string). The PricingSettings
// row is created lazily on first authenticated request via
// getOrCreatePricingSettings() in lib/auth.ts.
model PricingSettings {
  id String @id @default(cuid())

  // Foreign key into Supabase auth.users (we mirror the UUID as a string column —
  // no Prisma @relation since auth.users is in a different Postgres schema).
  userId String @unique

  // Company info (snapshot-copied into Estimate at creation)
  companyName               String
  companyPhone              String?
  companyAddress            String?
  businessRegistrationNumber String? // 사업자등록번호 (10자리, 하이픈 포함 가능)
  sealImageUrl              String?  // 직인 이미지 URL (Supabase Storage); null이면 PDF에서 "(인)" 텍스트 placeholder
  bankAccount               String?  // 입금 계좌 안내 (예: "신한 110-471-880754 · 광스틸")
  noticeText                String?  // 견적서 안내 문구 (줄바꿈 = \n 으로 구분, 자동 번호 매김)

  // Unit prices (all in Korean Won, integers)
  materialPricePerSqm       Int   // 칼라강판 ㎡당
  accessoryRate             Float // 부자재 비율 (e.g. 0.15 = 15%)
  ridgePricePerM            Int   // 용마루 m당
  eavePricePerM             Int   // 처마 마감 m당
  gutterPricePerM           Int   // 물받이 m당
  removalPricePerSqm        Int   // 철거 ㎡당
  wasteDisposalCost         Int   // 폐기물 처리비 (fixed)
  dailyWage                 Int   // 1인 1일 인건비
  defaultWorkerCount        Int   // 기본 작업 인원
  skyliftDailyCost          Int   // 스카이차 1일
  ladderTruckDailyCost      Int   // 사다리차 1일
  scaffoldDailyCost         Int   @default(150000) // (legacy lump-sum per-day; superseded by scaffoldPricePerSqmDay)
  scaffoldPricePerSqmDay    Int   @default(3000)  // 비계 ㎡·일당 단가 (primary model)
  baseTransportCost         Int   // 기본 운송비
  parapetMultiplier         Float @default(1.4)   // (현재 미사용 — 면적은 시공면적에 포함된 것으로 가정)

  // 자재 로스율 — 시공 시 자투리/낭비분
  defaultLossRate      Float   @default(0.15) // 15%
  useLossRateByDefault Boolean @default(false)
  /**
   * 로스율 적용 모드:
   *   "manual" — 항상 사용자가 정한 defaultLossRate (또는 견적별 입력값) 사용
   *   "auto"   — 지붕 형태 선택 시 ROOF_SHAPE_FACTORS 의 lossRate 자동 적용 (지붕형태 없으면 manual fallback)
   */
  lossRateMode         String  @default("auto")

  // 하지작업 단가
  substructureMode             String @default("wood")  // 'wood' | 'steel' — 새 견적 기본값
  substructureWoodPricePerSqm  Int    @default(30000)
  substructureSteelPricePerSqm Int    @default(40000)

  // 스틸방수 전용
  drainHolePrice               Int    @default(200000)  // 새 배수구 타공 1개당
  stainlessDrainPricePerM      Int    @default(50000)   // 스테인리스 배수로 m당 (스틸방수에서 물받이 대체)

  // 두겁 — 절곡 작업 m당 단가 (난간 시공 시 두겁 필수)
  capBendingPricePerM          Int    @default(5000)

  // 지붕공사 / 옥상지붕 — 엔드캡 1개당
  endCapPrice                  Int    @default(3500)

  // PE폼 부착 (결로/소음 방지) — 강판 ㎡당 추가 단가
  peFoamPricePerSqm            Int    @default(1000)

  // 스테인리스 배수로 - 홈통 (downspout) 1개당
  downspoutUnitPrice           Int    @default(50000)

  // ── 절곡 단가 및 기본 넓이 (자재 자동 추정용) ──
  // 절곡 비용 공식: 넓이mm × bendingPricePerMmPer3m × (길이m / 3)
  // 견적의 용마루/처마/두겁/미시/프래싱 등 절곡 작업 단가 산출에 사용
  bendingPricePerMmPer3m  Int  @default(36)   // mm·3m 기준 단가
  bendingWidthRidge       Int  @default(350)  // 용마루 기본 넓이 mm
  bendingWidthEave        Int  @default(250)  // 처마 기본 넓이 mm
  bendingWidthCap         Int  @default(200)  // 두겁 기본 넓이 mm
  bendingWidthMishi       Int  @default(150)  // 미시 기본 넓이 mm
  bendingWidthFlashing    Int  @default(200)  // 프래싱 기본 넓이 mm
  bendingWidthValley      Int  @default(300)  // 회침 기본 넓이 mm
  bendingWidthSnowGuard   Int  @default(180)  // 눈방지턱 기본 넓이 mm

  // ── 소모품 (자재 자동 추정용) ──
  screwLargePrice         Int  @default(300)    // 스크류 대 1개당
  screwSmallPrice         Int  @default(100)    // 스크류 소 1개당
  siliconePrice           Int  @default(5000)   // 실리콘 1개당
  insulationPricePerSqm   Int  @default(15000)  // 단열재 ㎡당

  // ── 베이스라인 데이터 (Phase 2 — 실제 시공 데이터 기반 추정용) ──
  // 비어있으면 기하학적 추정 fallback. 채워져 있으면 데이터 우선.
  // Shape: { roof: { area30: { rectangle: { gable: { bendingTotalM, ... } } } } }
  baselineData            Json?

  // Catalog category defaults (mode + simple-mode preset per category).
  // Shape: { finishing: {mode, simpleType, simpleValue}, gutter: {...}, ... }
  // When null/empty, defaults from lib/catalog.ts DEFAULT_CATEGORY_MODES apply.
  catalogDefaults              Json   @default("{}")
  mealCostPerPersonMeal     Int   // 1인 1식 식비
  lodgingCostPerPersonNight Int   // 1인 1박 숙박비

  // Defaults
  defaultMarginRate    Float   // e.g. 0.25 = 25%
  vatIncludedByDefault Boolean

  // 마진 분배 비율 — 견적서 PDF 에서 마진을 자재/인건비/이윤 세 갈래로
  // 흩뿌려서 표시하기 위한 비율. 합이 1.0 (100%) 이 되도록 사용자가 조정.
  // 합이 1.0 이 아니면 분배 시점에 정규화됨 (안전망).
  marginMaterialRatio  Float   @default(0.5)   // 자재 라인에 비례 분배
  marginLaborRatio     Float   @default(0.25)  // 인건비 라인에 비례 분배
  marginProfitRatio    Float   @default(0.25)  // "이윤" 별도 라인으로 노출

  // 견적 번호 시작값 — "YYYY-XXX" 형식의 XXX 가 이 숫자부터 시작.
  // 다른 시스템에서 마이그레이션하거나 특정 번호부터 시작하고 싶을 때 사용.
  // 새 견적 번호 = estimateNumberStart + (올해 이미 생성된 견적 수).
  // 기본 1 — 즉 첫 견적은 YYYY-001.
  estimateNumberStart  Int     @default(1)

  updatedAt DateTime @updatedAt
}

model Site {
  id            String     @id @default(cuid())
  // Owner — Supabase auth.users.id. Estimates inherit ownership via Site.
  userId        String
  customerName  String
  customerPhone String?
  siteAddress   String
  photos        Json       @default("[]") // [{url: string, memo?: string}, ...]
  generalMemo   String?
  estimates     Estimate[]
  createdAt     DateTime   @default(now())

  @@index([userId])
}

model Estimate {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  // Construction details (snapshotted)
  constructionType  String  @default("roof") // 'roof' | 'steelWaterproof' | 'rooftopRoof'
  materialType      String? // 'slate' | 'v250' | 'zinc250' | 'generalTile' | 'traditionalTile' | 'realZinc' | 'other'
  materialThickness String? @default("0.45") // '0.4' | '0.45' | '0.5' | '0.6'
  materialTexture   String? // '매트' | '광택' | '반광' | '엠보싱' | custom (free text)
  materialColor     String?

  // 공사 일정 — "YYYY-MM" format (snapshot); PDF renders as "YYYY년 MM월 중"
  // 지붕공사는 날씨로 일정이 자주 밀려서 정확한 착공/준공일은 안 잡음
  constructionMonth String?

  // Input snapshots
  areaM2          Float   // 시공 면적
  buildingAreaM2  Float?  // 건물 면적 (옵션, 참고용)
  workerCount     Int
  workDays        Float
  gutterLengthM   Float?
  warehouseAreaM2 Float?  // 창고 추가 시공 면적
  stairwellAreaM2 Float?  // 계단실 추가 시공 면적
  skyliftDays     Float?
  ladderTruckDays Float?
  scaffoldDays    Float?  // 비계 사용 일수
  otherEquipment  String? // 자유 텍스트 — 예: "크레인 1일, 지게차 2일"
  scopeFlags      Json    @default("{}") // ScopeFlags shape — see lib/types.ts

  // Loss rate snapshot (when applyLossRate, material area is multiplied by 1+lossRate)
  applyLossRate Boolean @default(false)
  lossRate      Float?  // snapshot of the rate used at creation time

  // Selected catalog items (마감재 / 물받이 부속 / 부자재 / 절곡) with snapshot prices
  // Shape: [{ category, key, label, unit, quantity, unitPrice }]
  catalogSelections Json @default("[]")

  // Per-category mode + simple-mode value snapshot.
  // Shape: { finishing: {mode, simpleType, simpleValue}, gutter: {...}, ... }
  catalogModes      Json @default("{}")

  // Per-estimate price overrides — apply only to this estimate.
  // Shape: Partial<PricingSettings> with only price fields the user changed.
  // buildLineItems merges this over PricingSettings before calculation.
  // PricingSettings itself is never modified.
  pricingOverrides  Json @default("{}")

  // 하지작업 (substructure)
  substructureType  String? // null = 안함, 'wood' = 목재, 'steel' = 철재

  // 폐기물 — 트럭당 단가 × 차 수
  wasteTruckCount   Int     @default(1)

  // 물받이 모드
  gutterMode        String? // null/'none' | 'full' | 'front' | 'back'

  // 스테인리스 배수로 길이 (스틸방수 — 물받이를 대체)
  stainlessDrainLengthM Float?

  // 비계 면적 (㎡·일 모델에서 사용)
  scaffoldAreaM2    Float?

  // 두겁 절곡 길이 (난간 시공 시 필수)
  capLengthM        Float?

  // 새 배수구 타공 개수 (스틸방수)
  drainHoleCount    Int      @default(0)

  // 엔드캡 개수 (지붕공사 / 옥상지붕)
  endCapCount       Int      @default(0)

  // ── 건물/지붕 형태 (자재 자동 추정용) ──
  buildingShape     String?  // 'rectangle' | 'lshape' | 'ushape'
  roofShape         String?  // 'gable' | 'hip' | 'halfHip' | 'shed' | 'mansard' | 'complex' | 'other'
  roofShapeNote     String?  // 복합/기타 선택 시 자유 메모
  perimeterM        Float?   // 직접 입력값. 없으면 형태+면적으로 추정
  ridgeCount        Int      @default(1)
  parapetHeightCm   Int?     // 스틸방수만 — 파라펫 강판 면적 계산에 사용
  /** 처마 돌출 cm — 지붕공사/옥상지붕만. 외곽 둘레 = 건물 둘레 + 8 × (d/100) */
  eaveOverhangCm    Int      @default(50)

  // ── 스틸방수 전용 (난간 둘레 직접 입력) ──
  /** 난간 둘레 (m) — 사용자 직접 입력. 외곽 + 계단 등 자유. 두겁/미시/파라펫강판 베이스 */
  railPerimeterM             Float?
  /** 옥탑 구조물 둘레 (m) — 계단실/창고 등. 없으면 0. 두겁/파라펫강판에 합산 */
  rooftopStructurePerimeterM Float?
  /** 옥탑 구조물 높이 (cm) — 옥탑 외벽 강판 면적 = 둘레 × 높이 × 로스율 */
  rooftopStructureHeightCm   Int?
  /** 옥탑 출입문 개수 — 트림 절곡 자동 계산 (문당 둘레 6m 가정) */
  rooftopDoorCount           Int     @default(0)
  /** 옥탑 창문 개수 — 트림 절곡 자동 계산 (창당 둘레 4m 가정) */
  rooftopWindowCount         Int     @default(0)
  /** 홈통 (downspout) 개수 — 스테인리스 배수로와 함께 시공 */
  downspoutCount             Int     @default(0)

  // ── 옵션 ──
  hasInsulation     Boolean  @default(false)  // [DEPRECATED] 구버전 단순 토글
  /** 단열재 종류 multi-select — 빈 배열 = 없음. ["eps", "xps", "pir", "thermalReflect", "other"] */
  insulationTypes   Json     @default("[]")
  /** 단열재 "기타" 선택 시 자유 메모 */
  insulationNote    String?
  /** PE폼 부착 (강판 ㎡당 추가 단가) — 보통 기본 시공이라 default true */
  hasPeFoam         Boolean  @default(true)

  // Line items in separate table (each holds its own unitPrice snapshot)
  lineItems EstimateLineItem[]

  // Summary snapshot (must equal sum of lineItems)
  totalCost    Int
  marginMode   String  // 'percent' | 'amount' | 'finalPrice'
  marginRate   Float   // final applied margin rate (incl. back-calculation result)
  marginAmount Int     // final applied margin in won
  supplyPrice  Int     // totalCost + marginAmount
  vat          Int     // VAT amount in won
  finalPrice   Int     // final quoted price
  vatIncluded  Boolean

  // Quote metadata
  paymentTerms String @default("계약금 10% / 잔금 90%")
  validityDays Int    @default(30)

  // Company info snapshot — frozen at estimate creation, never updated after
  companyNameSnapshot                String
  companyPhoneSnapshot               String?
  companyAddressSnapshot             String?
  businessRegistrationNumberSnapshot String?
  sealImageUrlSnapshot               String?
  bankAccountSnapshot                String?
  noticeTextSnapshot                 String?

  // 견적 번호 — "YYYY-NNN" 형식, 연도별 자동 채번 (created at the API)
  estimateNumber  String?

  // PDF record
  pdfUrl    String?   // Supabase Storage URL of generated PDF
  pdfSentAt DateTime? // timestamp when sent to customer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model EstimateLineItem {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  category  String  // 'material' | 'labor' | 'equipment' | 'transport' | 'meals' | 'lodging' | 'waste' | 'removal' | 'other'
  name      String  // human-readable: "칼라강판", "인건비", "스카이차"
  quantity  Float
  unit      String? // "㎡", "m", "일", "명·일"
  unitPrice Int     // SNAPSHOT: copied from PricingSettings at estimate creation — never recalculated
  total     Int     // quantity × unitPrice at creation; user may override directly

  isUserEdited Boolean @default(false) // true if user manually changed this line
  sortOrder    Int

  @@index([estimateId])
}
