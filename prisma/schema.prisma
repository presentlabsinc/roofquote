generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Live config — never FK-linked to Estimate
model PricingSettings {
  id String @id @default(cuid())

  // Company info (snapshot-copied into Estimate at creation)
  companyName    String
  companyPhone   String?
  companyAddress String?

  // Unit prices (all in Korean Won, integers)
  materialPricePerSqm     Int   // 칼라강판 ㎡당
  accessoryRate           Float // 부자재 비율 (e.g. 0.15 = 15%)
  ridgePricePerM          Int   // 용마루 m당
  eavePricePerM           Int   // 처마 마감 m당
  gutterPricePerM         Int   // 물받이 m당
  removalPricePerSqm      Int   // 철거 ㎡당
  wasteDisposalCost       Int   // 폐기물 처리비 (fixed)
  dailyWage               Int   // 1인 1일 인건비
  defaultWorkerCount      Int   // 기본 작업 인원
  skyliftDailyCost        Int   // 스카이차 1일
  ladderTruckDailyCost    Int   // 사다리차 1일
  baseTransportCost       Int   // 기본 운송비
  mealCostPerPersonMeal   Int   // 1인 1식 식비
  lodgingCostPerPersonNight Int // 1인 1박 숙박비

  // Defaults
  defaultMarginRate    Float   // e.g. 0.25 = 25%
  vatIncludedByDefault Boolean

  updatedAt DateTime @updatedAt
}

model Site {
  id            String     @id @default(cuid())
  customerName  String
  customerPhone String?
  siteAddress   String
  photos        String     @default("[]") // JSON: [{url, memo?}, ...]
  generalMemo   String?
  estimates     Estimate[]
  createdAt     DateTime   @default(now())
}

model Estimate {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  // Input snapshots
  areaM2          Float
  workerCount     Int
  workDays        Float
  gutterLengthM   Float?
  skyliftDays     Float?
  ladderTruckDays Float?
  scopeFlags      String @default("{}") // JSON: which scope checkboxes are on

  // Line items in separate table
  lineItems EstimateLineItem[]

  // Summary snapshot (must match sum of lineItems)
  totalCost    Int
  marginMode   String // 'percent' | 'amount' | 'finalPrice'
  marginRate   Float  // final applied margin rate (including back-calculation)
  marginAmount Int    // final applied margin amount
  supplyPrice  Int    // = totalCost + marginAmount
  vat          Int    // VAT amount
  finalPrice   Int    // final estimate price
  vatIncluded  Boolean

  // PDF metadata
  paymentTerms String @default("계약금 30% / 잔금 70%")
  validityDays Int    @default(30)

  // Company info snapshot (permanent, as of estimate creation)
  companyNameSnapshot    String
  companyPhoneSnapshot   String?
  companyAddressSnapshot String?

  // Send record
  pdfUrl    String?
  pdfSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstimateLineItem {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  category  String  // 'material' | 'labor' | 'equipment' | 'transport' | 'meals' | 'lodging' | 'waste' | 'removal' | 'other'
  name      String  // human-readable label: "칼라강판", "인건비", "스카이차"
  quantity  Float
  unit      String? // "㎡", "m", "일", "명·일"
  unitPrice Int     // snapshot of unit price at estimate creation time
  total     Int     // quantity × unitPrice (user-editable)

  isUserEdited Boolean @default(false)
  sortOrder    Int
}
